# ---------------------------------------------------------------------------
# PromptWars Sentinel - Environment Variables Template
# Copy this file to .env and configure for your environment.
# DO NOT commit real secrets or credentials to source control.
# ---------------------------------------------------------------------------

# Server Listen Configuration
PORT=8080
LOG_LEVEL=INFO

# Security & CORS Policy
# Unset or empty restricts to same-origin. Use * or specific domain for external callers.
ALLOWED_ORIGIN=*

# Per-IP Token-Bucket Rate Limiter Settings
RATE_LIMIT_PER_SEC=5
RATE_LIMIT_BURST=20
MAX_THREADS=64

# Optional Model Provider API Keys (Leave empty for deterministic offline heuristics)
GEMINI_API_KEY=
OPENAI_API_KEY=
